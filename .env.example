# Copie ce fichier en .env.local (développement) et renseigne les mêmes variables sur Vercel.
# Ne jamais committer de valeurs.

# ─── Supabase (projet de production) ───
# Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…) : serveur uniquement
SUPABASE_SECRET_KEY=

# ─── Twitch API (statut live de l'accueil) ───
# dev.twitch.tv → Your Console → Applications (même app que la connexion Twitch)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── SYXTEE Core (VPS) : dashboard (clés de stream, santé, aperçu) ───
# URL HTTPS du Core (Caddy) et jeton partagé : même valeur que CORE_API_TOKEN dans /opt/syxtee/.env
CORE_URL=
CORE_API_TOKEN=

# ─── Fonctions en pause ───
# SYXTEE Cam : « Bientôt disponible » tant que FEATURE_CAM n'est pas à true.
# FEATURE_CAM=false

# ─── Emails (Resend + « Send Email Hook » de Supabase) ───
# Clé API Resend (re_…). Sans elle, aucun email ne part (seulement journalisé).
RESEND_API_KEY=
# Expéditeur. Vide = expéditeur de test Resend (livre seulement à l'adresse du compte Resend).
# Une fois le domaine vérifié : SYXTEE <connexion@ton-domaine>
EMAIL_FROM=
# Secret du hook (Supabase → Authentication → Hooks → Send Email), format v1,whsec_…
SEND_EMAIL_HOOK_SECRET=
# Admins (accès /admin et /dev/emails), séparés par des virgules
ADMIN_EMAILS=

# ─── Tests e2e uniquement (.env.test.local, projet Supabase de TEST) ───
# E2E_SUPABASE_URL=
# E2E_SUPABASE_PUBLISHABLE_KEY=
# E2E_SUPABASE_SECRET_KEY=
