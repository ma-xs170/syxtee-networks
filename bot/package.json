{
  "name": "syxtee-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SYXTEE Bot : bot Discord (nouveautés, état des services, commandes) hébergé sur le VPS.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
