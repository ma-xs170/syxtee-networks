# SYXTEE Core avec la régie (mire automatique) : ajoute GStreamer + le plugin fallbackswitch (gst-plugins-rs),
# compilé ici car absent des paquets Debian. Compilation Rust : ~10 min, 4 Go de RAM conseillés.
# Mire : polices Geist (assets/fonts) installées pour librsvg et clockoverlay ; heure au fuseau REGIE_TZ.
# À construire seulement sur un VPS 4 Go+ (REGIE_ENABLED=true). Validé en local (macOS, GStreamer 1.28, gst-plugins-rs 0.15.3).
# 0.15.x obligatoire : fallbacksrc y a la propriété enable-dummy utilisée par la mire (absente en 0.14). Version validée en local : 0.15.3.
ARG GST_RS_VERSION=0.15.3

FROM rust:1-slim-trixie AS gstrs
ARG GST_RS_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends git pkg-config libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${GST_RS_VERSION} https://gitlab.freedesktop.org/gstreamer/gst-plugins-rs.git /src
WORKDIR /src
RUN cargo build --release -p gst-plugin-fallbackswitch \
 && cp target/release/libgstfallbackswitch.so /libgstfallbackswitch.so

FROM node:24-trixie-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:24-trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg ca-certificates tini fonts-dejavu-core fontconfig tzdata \
    gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav \
 && rm -rf /var/lib/apt/lists/*
COPY --from=gstrs /libgstfallbackswitch.so /usr/lib/x86_64-linux-gnu/gstreamer-1.0/
WORKDIR /app
ENV NODE_ENV=production DATA_DIR=/app/data
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./
COPY assets ./assets
# Polices du site (Geist, licence OFL) pour la mire et l'heure.
COPY assets/fonts /usr/local/share/fonts/geist
RUN fc-cache -f
USER node
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/index.js"]
