# /opt/syxtee/.env (chmod 600). Ne jamais committer.

# Domaine HTTPS de l'API du Core (Caddy). Sans domaine : <ip-avec-tirets>.sslip.io
CORE_DOMAIN=

# Jeton partagé avec Vercel (même valeur que CORE_API_TOKEN sur Vercel). Générer : openssl rand -hex 32
CORE_API_TOKEN=

# Supabase (projet de production)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Clé de l'API du srt-live-server : contenu du fichier .apikey du srtla-receiver
SLS_API_KEY=

# Ce que les streamers collent dans Moblin / OBS : IP publique du VPS ou un domaine (ex. relais.syxtee.fr)
RELAY_PUBLIC_HOST=
RELAY_NAME=nyc1

# Sites autorisés à appeler le Core depuis le navigateur
CORS_ORIGINS=https://syxtee-networks.vercel.app,http://localhost:3000

# Heure affichée sur la mire
TZ=America/Guadeloupe

# Régie : false sur le VPS 1 Go. true seulement avec CORE_DOCKERFILE=Dockerfile.regie et 4 Go / 2 vCPU minimum.
REGIE_ENABLED=false
# CORE_DOCKERFILE=Dockerfile.regie
