{
  "name": "syxtee-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SYXTEE Core : clés de stream, santé du flux, aperçus et régie (VPS).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
