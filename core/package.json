    "fastify": "^5.4.0",
    "h3-js": "^4.5.0",
    "jose": "^6.0.0",
    "mmdb-lib": "^3.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
